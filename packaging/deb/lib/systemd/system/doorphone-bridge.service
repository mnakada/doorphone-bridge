[Unit]
Description=Doorphone to HomeKit bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=doorphone-bridge
Group=doorphone-bridge
Environment=NODE_ENV=production
Environment=CONFIG_PATH=/etc/doorphone-bridge/config.json
WorkingDirectory=/opt/doorphone-bridge
ExecStart=/usr/bin/node /opt/doorphone-bridge/bin/doorphone-bridge serve
Restart=on-failure
RestartSec=5
# The app exits 75 after a successful re-pair from the Web UI so it boots
# again with the new cert; always restart on that code.
RestartForceExitStatus=75
# Runtime dirs managed by systemd (/run/doorphone-bridge)
RuntimeDirectory=doorphone-bridge
RuntimeDirectoryMode=0750
StateDirectory=doorphone-bridge
StateDirectoryMode=0750
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Pairing needs to drop cert/key/unit into /etc/doorphone-bridge; otherwise the
# service has only the credentials file open for writes.
ReadWritePaths=/var/lib/doorphone-bridge /etc/doorphone-bridge
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
