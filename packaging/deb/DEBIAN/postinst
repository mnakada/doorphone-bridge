#!/bin/sh
# postinst for doorphone-bridge
set -e

USER_NAME=doorphone-bridge
STATE_DIR=/var/lib/doorphone-bridge
CONFIG_DIR=/etc/doorphone-bridge

case "$1" in
  configure)
    # System user for the service (no shell, no mail).
    if ! getent passwd "$USER_NAME" >/dev/null; then
      adduser --system --group --home "$STATE_DIR" --no-create-home \
              --shell /usr/sbin/nologin "$USER_NAME"
    fi

    # Runtime state and config directories.
    mkdir -p "$STATE_DIR/persist"
    chown -R "$USER_NAME:$USER_NAME" "$STATE_DIR"
    chmod 0750 "$STATE_DIR"

    mkdir -p "$CONFIG_DIR"
    # Credentials and private keys live here. Give the service user ownership
    # so it can rotate kvs_creds.json automatically via the MQTT refresher.
    chown -R "$USER_NAME:$USER_NAME" "$CONFIG_DIR"
    chmod 0750 "$CONFIG_DIR"
    find "$CONFIG_DIR" -type f -exec chmod 0640 {} +

    # node_modules is shipped in the .deb (built inside a linux/arm64
    # container), so no network fetch is needed on install.

    # Service always starts: pairing happens via the Web UI on port 8080 even
    # when no credentials are present yet.

    # Reload systemd, enable + (re)start the service.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      systemctl enable doorphone-bridge.service || true
      systemctl restart doorphone-bridge.service || true
      HOST_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
      echo
      echo "doorphone-bridge installed. Pair via the Web UI:"
      echo "  http://${HOST_IP:-<this-host>}:8080/"
      echo "or from the CLI:"
      echo "  sudo doorphone-bridge pair <qr.jpg|qr.png|https://intercom.iot-webrtc.net/reg/...>"
      echo
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

exit 0
